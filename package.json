{
  "name": "loopmm",
  "productName": "loopmm",
  "version": "0.2.0",
  "description": "Chat with loopmm, a small looped multimodal model, offline on your Mac.",
  "main": "main.js",
  "license": "Apache-2.0",
  "scripts": {
    "prepare-web": "node scripts/prepare.mjs",
    "start": "electron .",
    "dist": "electron-builder --mac --arm64 --x64 --publish never"
  },
  "dependencies": {
    "onnxruntime-web": "1.30.0",
    "@huggingface/tokenizers": "0.1.3"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "dev.mostlime.loopmm",
    "productName": "loopmm",
    "files": [
      "main.js",
      "web/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models"
      }
    ],
    "asarUnpack": [],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "loopmm-${version}-${arch}-mac.${ext}"
    },
    "dmg": {
      "artifactName": "loopmm-${version}-${arch}.dmg"
    }
  }
}